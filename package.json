{
	"name": "i18n-iso-countries-extended-info",
	"version": "1.8.0",
	"description": "i18n-iso-countries-extended-info package provides basic and additional information about countries around the world based on ISO codes and name. Information includes capital, official language names, continents, time zones (with utc offsets), and internet domains",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./data": {
			"import": {
				"types": "./dist/data.d.mts",
				"default": "./dist/data.mjs"
			},
			"require": {
				"types": "./dist/data.d.ts",
				"default": "./dist/data.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"prestart": "npx ts-node src/prebuildStep/checkCountryCurrencySync.ts && npx ts-node src/prebuildStep/createDatasetFile.ts",
		"start": "npx ts-node src/devUtils/launchApp.ts",
		"build": "tsup",
		"release": "npm run build && commit-and-tag-version",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write",
		"test": "jest",
		"docs": "npx readme-tsdoc",
		"prepublishOnly": "npm run docs && npm run build",
		"test:pack": "npm run build && ./scripts/smokePack.sh"
	},
	"keywords": [
		"i18n",
		"iso",
		"3166",
		"iso 3166",
		"iso 3166-1",
		"alpha",
		"alpha-2",
		"alpha-3",
		"numeric",
		"country",
		"countries",
		"iso codes",
		"time zones",
		"continents",
		"official languages",
		"internet domains",
		"time zones (utc offset)"
	],
	"author": "Amitt K Sharma",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amittkSharma/i18n-iso-countries-extended-info.git"
	},
	"homepage": "https://github.com/amittkSharma/i18n-iso-countries-extended-info#readme",
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@tsconfig/node20": "^20.1.4",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.19.14",
		"@types/pino": "^7.0.5",
		"commit-and-tag-version": "^12.4.1",
		"countries-and-timezones": "^3.8.0",
		"countries-db": "^1.2.0",
		"jest": "^30.2.0",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.2",
		"readme-tsdoc": "^1.1.4",
		"ts-jest": "^29.4.5",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"tsup": "^8.5.1",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"i18n-iso-countries": "^7.14.0"
	},
	"commit-and-tag-version": {
		"noVerify": false,
		"silent": false,
		"skip": {
			"changelog": false,
			"bump": false,
			"commit": true,
			"tag": false
		}
	}
}
